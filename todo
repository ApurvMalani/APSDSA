import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		 to_do();

	}
	static void to_do(){

        Scanner scanner = new Scanner(System.in);
        int t = scanner.nextInt();

        while (t-->0){
            int n = scanner.nextInt();
            int[] difficulty_rating = new int[n];

            // input array
           for (int i=0;i<n;i++){
                difficulty_rating[i] = scanner.nextInt();
           }
              int count =0;
           for (int i=0;i<n;i++){
               if (difficulty_rating[i]>=1000){
                   count++;
               }
           }
            System.out.println(count);

        }

     }
}
